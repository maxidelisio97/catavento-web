{
  "name": "catavento-payments-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "register-webhook": "tsx scripts/register-webhook.ts",
    "confirm-sandbox-payment": "tsx scripts/confirm-sandbox-payment.ts",
    "migrate:up": "node-pg-migrate up -j ts",
    "migrate:down": "node-pg-migrate down -j ts",
    "codegen": "kysely-codegen --out-file src/db/types.ts",
    "seed:rooms": "tsx scripts/seed-rooms.ts",
    "check:reservation-nights": "tsx scripts/checkReservationNightsConsistency.ts"
  },
  "dependencies": {
    "@fastify/type-provider-zod": "^1.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.10.0",
    "kysely": "^0.29.4",
    "kysely-codegen": "^0.20.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
